{
  "name": "docs-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sync Markdown docs from this repo to Google Drive (one-way, push-only). Phase 1 MVP.",
  "scripts": {
    "push": "tsx scripts/push.ts",
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "tsx scripts/check-boundaries.ts",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write \"docs/**/*.md\" \"README.md\"",
    "format:check": "prettier --check \"docs/**/*.md\" \"README.md\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.md": "prettier --write"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mohtasham/md-to-docx": "^2.18.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^144.0.0",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
