{
  "name": "@zenskar/docpipe",
  "version": "0.1.0",
  "type": "module",
  "description": "Config-driven pipeline that publishes Markdown docs from Git to Google Docs (one-way mirror). Adopt in any repo with a manifest + shared CI.",
  "bin": {
    "docpipe": "dist/cli/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli/cli.js",
    "docpipe": "tsx src/cli/cli.ts",
    "push": "tsx src/cli/cli.ts push",
    "dry-run": "tsx src/cli/cli.ts plan",
    "typecheck": "tsc --noEmit",
    "lint:boundaries": "tsx scripts/check-boundaries.ts",
    "test": "vitest run --passWithNoTests",
    "coverage": "vitest run --coverage",
    "format": "prettier --write \"docs/**/*.md\" \"README.md\"",
    "format:check": "prettier --check \"docs/**/*.md\" \"README.md\"",
    "prepublishOnly": "npm run build",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.md": "prettier --write"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mohtasham/md-to-docx": "^2.18.0",
    "google-auth-library": "^9.15.1",
    "googleapis": "^144.0.0",
    "gray-matter": "^4.0.3",
    "jszip": "^3.10.1",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^2.1.9",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "prettier": "^3.9.4",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
