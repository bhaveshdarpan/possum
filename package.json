{
  "name": "docs-sync",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sync Markdown docs from this repo to Google Drive (one-way, push-only). Phase 1 MVP.",
  "scripts": {
    "push": "tsx scripts/push.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:md": "markdownlint-cli2",
    "lint:md:fix": "markdownlint-cli2 --fix",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.md": "markdownlint-cli2 --fix"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@mohtasham/md-to-docx": "^2.12.0",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.5",
    "markdownlint-cli2": "^0.22.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
